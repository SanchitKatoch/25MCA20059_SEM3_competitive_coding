Leetcode : 492
https://leetcode.com/problems/construct-the-rectangle/submissions/2133680054/

class Solution {
public:
    vector<int> constructRectangle(int area) {
        vector<int> answer(2);
        int width=sqrt(area);
        while(area%width){
            width--;
        }
        int length=area/width;
        answer[0]=length;
        answer[1]=width;
        return(answer);        
    }
};
